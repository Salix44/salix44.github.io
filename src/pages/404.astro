---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 페이지를 찾을 수 없습니다." robots="noindex,follow">
  <section class="container page-head page-head--center">
    <p class="eyebrow">404</p>
    <h1>페이지를 찾을 수 없습니다.</h1>
    <p>주소가 바뀌었거나 아직 작성되지 않은 글일 수 있습니다.</p>
    <a class="button" href={withBase("/")}>홈으로</a>
  </section>
</BaseLayout>
