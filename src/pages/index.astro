---
import { getCollection } from "astro:content";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSortedPosts, getTagCounts } from "../lib/blog";
import { withBase } from "../lib/url";

const posts = getSortedPosts(await getCollection("blog"));
const tagCounts = getTagCounts(posts).slice(0, 8);
---

<BaseLayout
  title="Salix"
  description="코드, 게임, 자료를 차분하게 정리하는 한국어 블로그입니다."
  pageClass="home-page"
>
  <section class="container home-feed" aria-labelledby="home-title">
    <div class="home-feed__head">
      <h1 id="home-title">최근 글</h1>
      <a href={withBase("/posts/")}>전체 보기</a>
    </div>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="container section home-tags">
    <div class="home-tags__head">
      <p class="eyebrow">태그</p>
      <a href={withBase("/tags/")}>전체 태그</a>
    </div>
    <ul class="tag-cloud" aria-label="주요 태그">
      {tagCounts.map(([tag, count]) => <li><a href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>{tag}<span>{count}</span></a></li>)}
    </ul>
  </section>
</BaseLayout>
