---
import "../styles/global.css";
import { absoluteUrl, withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
  pageClass?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const siteTitle = "Salix";
const siteDescription = "코드, 게임, 자료를 차분하게 정리하는 한국어 블로그";
const {
  title = siteTitle,
  description = siteDescription,
  ogImage = "/images/blog-hero.png",
  ogType = "website",
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  pageClass = "",
  robots = "index,follow",
  structuredData = []
} = Astro.props;
const pageTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const canonical = absoluteUrl(Astro.url.pathname.replace(import.meta.env.BASE_URL, "/"), Astro.site);
const ogImageUrl = absoluteUrl(ogImage, Astro.site);
const siteUrl = absoluteUrl("/", Astro.site);
const navItems = [
  { href: "/", label: "홈" },
  { href: "/posts/", label: "글" },
  { href: "/tags/", label: "태그" },
  { href: "/about/", label: "소개" }
];
const currentYear = new Date().getFullYear();
const enableGoogleTagManager = import.meta.env.PROD;
const baseStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteTitle,
  url: siteUrl,
  description: siteDescription,
  inLanguage: "ko-KR"
};
const structuredDataItems = [
  baseStructuredData,
  ...(Array.isArray(structuredData) ? structuredData : [structuredData])
].filter(Boolean);
const structuredDataJson = JSON.stringify(structuredDataItems).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {
      enableGoogleTagManager && (
        <>
          <!-- Google Tag Manager -->
          <script is:inline>
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer','GTM-NXF5ZBNC');
          </script>
          <!-- End Google Tag Manager -->
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} />
    <meta name="theme-color" content="#f5f7ef" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {section && <meta property="article:section" content={section} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={structuredDataJson} is:inline></script>
  </head>
  <body class={pageClass}>
    {
      enableGoogleTagManager && (
        <>
          <!-- Google Tag Manager (noscript) -->
          <noscript>
            <iframe
              src="https://www.googletagmanager.com/ns.html?id=GTM-NXF5ZBNC"
              height="0"
              width="0"
              style="display:none;visibility:hidden"
            ></iframe>
          </noscript>
          <!-- End Google Tag Manager (noscript) -->
        </>
      )
    }
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={withBase("/")} aria-label="Salix 홈">
          <span class="brand__logo">Salix</span>
        </a>
        <nav class="site-nav" aria-label="주요 메뉴">
          {navItems.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <a class="site-footer__brand" href={withBase("/")}>Salix</a>
          <p>© {currentYear}</p>
        </div>
        <nav class="site-footer__nav" aria-label="하단 메뉴">
          {navItems.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
        </nav>
      </div>
    </footer>
  </body>
</html>
