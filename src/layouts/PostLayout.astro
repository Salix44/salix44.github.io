---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { BlogPost } from "../lib/blog";
import BaseLayout from "./BaseLayout.astro";
import CusdisComments from "../components/CusdisComments.astro";
import { formatDate, postPath } from "../lib/blog";
import { absoluteUrl, withBase } from "../lib/url";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: BlogPost;
  headings: Heading[];
}

const { post, headings } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const localImages = import.meta.glob<{ default: ImageMetadata }>(
  "../content/blog/**/*.{png,jpg,jpeg,webp,avif,gif}",
  { eager: true }
);
const sourcePath =
  "filePath" in post && typeof post.filePath === "string"
    ? post.filePath.replace(/\\/g, "/")
    : `src/content/blog/${post.id}.md`;
const postDirectory = sourcePath
  .replace(/^src\/content\/blog\//, "")
  .split("/")
  .slice(0, -1)
  .join("/");
const relativeHero = post.data.hero?.startsWith("./")
  ? post.data.hero.replace(/^\.\//, "")
  : undefined;
const localHeroEntry = relativeHero
  ? Object.entries(localImages).find(
      ([path]) =>
        path.endsWith(`/${post.id}/${relativeHero}`) ||
        path.endsWith(`/${postDirectory}/${relativeHero}`)
    )
  : undefined;
const localHero = localHeroEntry?.[1].default;
const publicHero = post.data.hero?.startsWith("/") ? post.data.hero : undefined;
const heroImage = localHero?.src ?? publicHero;
const heroImageUrl = heroImage ? absoluteUrl(heroImage, Astro.site) : undefined;
const heroAlt = post.data.heroAlt ?? `${post.data.title} 대표 이미지`;
const postUrl = absoluteUrl(postPath(post), Astro.site);
const publishedTime = post.data.publishDate.toISOString();
const modifiedTime = (post.data.updatedDate ?? post.data.publishDate).toISOString();
const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  url: postUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl
  },
  datePublished: publishedTime,
  dateModified: modifiedTime,
  inLanguage: "ko-KR",
  articleSection: post.data.category,
  keywords: post.data.tags.join(", "),
  author: {
    "@type": "Person",
    name: "Salix"
  },
  publisher: {
    "@type": "Person",
    name: "Salix"
  },
  image: heroImageUrl ? [heroImageUrl] : undefined
};
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "홈",
      item: absoluteUrl("/", Astro.site)
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "글",
      item: absoluteUrl("/posts/", Astro.site)
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.data.title,
      item: postUrl
    }
  ]
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={heroImage}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  section={post.data.category}
  tags={post.data.tags}
  structuredData={[articleStructuredData, breadcrumbStructuredData]}
>
  <article class="post-detail">
    <header class="post-hero container">
      <a class="back-link" href={withBase("/posts/")}>글 목록</a>
      <div class="post-hero__meta">
        <span>{post.data.category}</span>
        <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
      </div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <ul class="tag-list tag-list--large" aria-label="태그">
        {post.data.tags.map((tag) => <li><a href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a></li>)}
      </ul>
      {
        localHero ? (
          <Image src={localHero} alt={heroAlt} loading="eager" />
        ) : (
          publicHero && <img src={withBase(publicHero)} alt={heroAlt} loading="eager" />
        )
      }
    </header>
    <div class:list={["container", "post-shell", tocHeadings.length === 0 && "post-shell--single"]}>
      {
        tocHeadings.length > 0 && (
          <aside class="toc" aria-label="목차">
            <strong>목차</strong>
            <nav>
              {tocHeadings.map((heading) => (
                <a class={`toc__link toc__link--depth-${heading.depth}`} href={`#${heading.slug}`}>
                  {heading.text}
                </a>
              ))}
            </nav>
          </aside>
        )
      }
      <div class="post-content">
        <div class="prose">
          <slot />
        </div>
        <CusdisComments post={post} />
      </div>
    </div>
  </article>
</BaseLayout>
