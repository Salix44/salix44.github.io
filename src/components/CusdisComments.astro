---
import type { BlogPost } from "../lib/blog";
import { postPath, postSlug } from "../lib/blog";
import { absoluteUrl } from "../lib/url";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const appId = import.meta.env.PUBLIC_CUSDIS_APP_ID || "df9501ab-09fb-4a85-91c7-83a9ebf91896";
const host = import.meta.env.PUBLIC_CUSDIS_HOST || "https://cusdis.com";
const pageId = postSlug(post);
const pageUrl = absoluteUrl(postPath(post), Astro.site);
---

<section class="comments" aria-labelledby="comments-title">
  <div class="comments__head">
    <h2 id="comments-title">Comments</h2>
  </div>
  <div class="comments__body">
    <div
      id="cusdis_thread"
      data-host={host}
      data-app-id={appId}
      data-page-id={pageId}
      data-page-url={pageUrl}
      data-page-title={post.data.title}
      data-theme="light"
    />
  </div>
  <script is:inline async defer src={`${host}/js/cusdis.es.js`}></script>
  <script is:inline>
    (() => {
      const section = document.currentScript?.closest(".comments");
      const thread = section?.querySelector("#cusdis_thread");
      const iframeHeightBuffer = 40;
      const iframeMinHeight = 360;
      const setIframeFrame = () => {
        const iframe = thread?.querySelector("iframe");

        if (!iframe) {
          return undefined;
        }

        iframe.setAttribute("scrolling", "no");
        iframe.style.display = "block";
        iframe.style.overflow = "hidden";
        iframe.style.minHeight = `${iframeMinHeight}px`;

        return iframe;
      };

      const observer = new MutationObserver(setIframeFrame);

      if (thread) {
        observer.observe(thread, { childList: true, subtree: true });
      }

      setIframeFrame();

      window.addEventListener("message", (event) => {
        let message;

        try {
          message = JSON.parse(event.data);
        } catch {
          return;
        }

        if (message?.from !== "cusdis" || message.event !== "resize") {
          return;
        }

        const height = Number(message.data);

        if (!Number.isFinite(height)) {
          return;
        }

        requestAnimationFrame(() => {
          const iframe = setIframeFrame();

          if (iframe) {
            iframe.style.height = `${Math.max(Math.ceil(height) + iframeHeightBuffer, iframeMinHeight)}px`;
          }
        });
      });
    })();
  </script>
</section>
