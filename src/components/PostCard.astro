---
import type { BlogPost } from "../lib/blog";
import { formatDate, postPath } from "../lib/blog";
import { withBase } from "../lib/url";

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const tags = post.data.tags.join(" ");
---

<article
  class:list={["post-card", { "post-card--featured": featured }]}
  data-title={post.data.title}
  data-description={post.data.description}
  data-category={post.data.category}
  data-tags={tags}
>
  <div class="post-card__meta">
    <span>{post.data.category}</span>
    <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
  </div>
  <h3>
    <a href={withBase(postPath(post))}>{post.data.title}</a>
  </h3>
  <p>{post.data.description}</p>
  <ul class="tag-list" aria-label={`${post.data.title} 태그`}>
    {post.data.tags.map((tag) => <li><a href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a></li>)}
  </ul>
</article>
